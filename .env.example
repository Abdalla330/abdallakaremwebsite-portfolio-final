# Web server
PORT=8080

# PostgreSQL / Amazon RDS
DB_HOST=your-rds-endpoint.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_USER=postgres
DB_PASS=replace-with-your-database-password
DB_NAME=abdalla_dc_website

# Optional Amazon S3
S3_BUCKET=
S3_REGION=us-east-1

# Preferred on EC2: use an IAM role and leave access keys blank.
S3_ACCESS_KEY=
S3_SECRET_KEY=
